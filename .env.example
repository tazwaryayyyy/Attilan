# Copy to .env. Use URL-safe random values. Never commit .env.
ENVIRONMENT=production
POSTGRES_DB=attilan
DB_BOOTSTRAP_USER=CHANGE_ME_BOOTSTRAP_USER
DB_BOOTSTRAP_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD
API_WORKER_PASSWORD=CHANGE_ME_API_WORKER_PASSWORD
AUDIT_REPLICA_PASSWORD=CHANGE_ME_AUDIT_REPLICA_PASSWORD

MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
