# Attilan Stage D Production Environment Template
ENVIRONMENT=production
PROJECT_NAME="Attilan Criminal Intelligence & Evidence Integrity Platform"

# PostgreSQL 17 + PostGIS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=opencase_bd
DATABASE_URL=postgresql://postgres:change_me_in_production@db_core:5432/opencase_bd

# MinIO S3 WORM Storage (Compliance Mode)
MINIO_ENDPOINT=minio_worm:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_SECURE=false
MINIO_EVIDENCE_BUCKET=evidence_bucket
MINIO_RETENTION_YEARS=10

# Cryptographic Keys & Remote Syslog Webhook
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
APP_PRIVATE_SIGNING_KEY=generate_with_openssl_rand_hex_64
REMOTE_AUDIT_WEBHOOK_URL=https://syslog.audit-external.bd/checkpoint
BROADCAST_INTERVAL_SECONDS=300
